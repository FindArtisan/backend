# FindArtisan API environment configuration
# Copy this file to .env and adjust values as needed.

# Application
DEBUG=false

# Database (async SQLAlchemy URL)
# Development default is SQLite; for Postgres use e.g.:
# postgresql+asyncpg://user:password@localhost:5432/findartisan
DATABASE_URL=sqlite+aiosqlite:///./findartisan.db

# Auth / JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
